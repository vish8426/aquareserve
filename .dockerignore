# Keep the build context small and force a clean precompute inside the image.
.git
.github
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# node / build outputs (both frontends are rebuilt)
frontend/node_modules
frontend/dist
product/node_modules
product/dist

# python envs
.venv
venv
env

# regenerable data - the image precomputes these itself
data/results
viz/twin_data.json
viz/_widget*.html

# docs and local cruft not needed at runtime
docs
*.md
!README.md
